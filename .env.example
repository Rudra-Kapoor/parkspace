# =============================================================================
# ParkSpace environment
# =============================================================================
# Copy this file to .env.local and fill it in. .env.local is git-ignored.
#
#   cp .env.example .env.local
#
# Everything here has a free tier. There is no paid service in the default setup.
# =============================================================================


# -----------------------------------------------------------------------------
# Supabase  (required)
# -----------------------------------------------------------------------------
# Create a free project at https://supabase.com/dashboard
# Then open Project Settings, API, and copy the three values below.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# The anon key. Safe to ship to the browser: every table it can reach is
# protected by Row Level Security.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# The service role key. This BYPASSES every Row Level Security policy.
#
# Never prefix it with NEXT_PUBLIC_. Never import it into a client component.
# Never paste it into a chat, an issue or a screenshot. If it leaks, rotate it
# immediately in Project Settings, API, Reset service role key.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# A personal access token, used only by `npm run db:push` to apply migrations
# through the Supabase Management API. Create one at:
#   https://supabase.com/dashboard/account/tokens
# Not needed at runtime, and not needed at all once the schema is in place.
SUPABASE_ACCESS_TOKEN=sbp_your_personal_access_token


# -----------------------------------------------------------------------------
# Site  (required)
# -----------------------------------------------------------------------------
# The public URL of this deployment. Used for auth redirects, the sitemap and
# webhook callbacks. Locally this is http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# -----------------------------------------------------------------------------
# Maps  (no key needed)
# -----------------------------------------------------------------------------
# Maps use MapLibre GL with OpenStreetMap raster tiles, and geocoding uses
# Nominatim. Both are free and neither needs an API key, which is why they were
# chosen over Google Maps.
#
# The Nominatim usage policy requires an identifying User-Agent with a way to
# contact you. Put a real contact address here before you send real traffic.
NOMINATIM_USER_AGENT=ParkSpace/0.1 (contact: you@example.com)

# Which basemap to draw. 'osm-raster' is the default and needs no key.
NEXT_PUBLIC_MAP_STYLE=osm-raster

# Where the map opens before the user tells us anything. Default is Kolkata.
NEXT_PUBLIC_DEFAULT_CITY=Kolkata
NEXT_PUBLIC_DEFAULT_LAT=22.5726
NEXT_PUBLIC_DEFAULT_LNG=88.3639


# -----------------------------------------------------------------------------
# Payments
# -----------------------------------------------------------------------------
# 'mock' runs the full booking and confirmation flow without a merchant account.
# It signs its webhooks properly, so the same verification code runs as in
# production. Use it for development and demonstrations.
#
# 'razorpay' uses a real gateway. Razorpay test mode is free and gives you test
# cards and a test UPI flow.
PAYMENT_PROVIDER=mock

# Only needed when PAYMENT_PROVIDER=razorpay.
# From https://dashboard.razorpay.com/app/keys  (start in Test Mode)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# From the Razorpay dashboard, Settings, Webhooks. Point the webhook at
# https://your-domain/api/payments/webhook and subscribe to
# payment.captured, payment.failed and payment.authorized.
RAZORPAY_WEBHOOK_SECRET=

# Optional. Changes the HMAC key the mock provider signs with.
MOCK_PAYMENT_SECRET=

# Set this to true ONLY for a deliberate demonstration deployment where you want
# bookings to confirm without taking money. Leave it unset otherwise: the mock
# provider refuses to start in production without it, on purpose.
ALLOW_MOCK_PAYMENTS=


# -----------------------------------------------------------------------------
# Scheduled jobs
# -----------------------------------------------------------------------------
# A random secret protecting /api/cron. Without it, anyone could expire every
# pending hold in the system. Generate one with:
#
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# On Vercel, set this as an environment variable and Vercel Cron will send it
# automatically as a bearer token.
CRON_SECRET=
